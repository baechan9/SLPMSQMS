<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsOverdue__c</fullName>
    <formula>AND(NOT(ISPICKVAL(Status__c, 'CLOSED')), NOT(ISPICKVAL(Status__c, 'CANCELLED')), TargetDate__c &lt; TODAY())</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>기한 경과</label>
    <type>Checkbox</type>
</CustomField>
