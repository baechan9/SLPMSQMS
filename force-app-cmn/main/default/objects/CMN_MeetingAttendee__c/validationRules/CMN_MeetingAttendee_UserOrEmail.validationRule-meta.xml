<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_MeetingAttendee_UserOrEmail</fullName>
    <active>true</active>
    <description>사내 사용자 또는 외부 메일 중 하나</description>
    <errorConditionFormula>AND(ISBLANK(User__c), ISBLANK(ExternalEmail__c))</errorConditionFormula>
    <errorMessage>사용자 또는 외부 메일을 입력하세요.</errorMessage>
</ValidationRule>
