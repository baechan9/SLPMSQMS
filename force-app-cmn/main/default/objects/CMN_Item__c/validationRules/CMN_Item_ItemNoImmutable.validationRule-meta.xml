<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Item_ItemNoImmutable</fullName>
    <active>true</active>
    <description>품번은 SAP 키·연결 외부 키라 바꾸지 않는다(이관 모드 예외)</description>
    <errorConditionFormula>AND(ISCHANGED(ItemNo__c), NOT($Permission.CMN_DataMigration))</errorConditionFormula>
    <errorDisplayField>ItemNo__c</errorDisplayField>
    <errorMessage>코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).</errorMessage>
</ValidationRule>
