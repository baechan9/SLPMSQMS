<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Item_FgRequiresCustomer</fullName>
    <active>true</active>
    <description>BR-1: 완제품은 고객 필수</description>
    <errorConditionFormula>AND(ISPICKVAL(ItemType__c, 'FG'), ISBLANK(Customer__c))</errorConditionFormula>
    <errorDisplayField>Customer__c</errorDisplayField>
    <errorMessage>완제품(FG)은 고객이 필요합니다.</errorMessage>
</ValidationRule>
