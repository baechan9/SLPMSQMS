<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Characteristic_ActiveNeedsFrom</fullName>
    <active>true</active>
    <description>ACTIVE면 적용 시작일 필수</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, 'ACTIVE'), ISBLANK(EffectiveFrom__c))</errorConditionFormula>
    <errorDisplayField>EffectiveFrom__c</errorDisplayField>
    <errorMessage>활성 특성은 적용 시작일이 필요합니다.</errorMessage>
</ValidationRule>
