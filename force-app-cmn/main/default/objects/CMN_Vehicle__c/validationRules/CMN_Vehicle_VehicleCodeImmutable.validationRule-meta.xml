<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Vehicle_VehicleCodeImmutable</fullName>
    <active>true</active>
    <description>차종 코드는 외부 키의 일부라 바꾸지 않는다. 이관 모드만 예외</description>
    <errorConditionFormula>AND(ISCHANGED(VehicleCode__c), NOT($Permission.CMN_DataMigration))</errorConditionFormula>
    <errorDisplayField>VehicleCode__c</errorDisplayField>
    <errorMessage>코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).</errorMessage>
</ValidationRule>
