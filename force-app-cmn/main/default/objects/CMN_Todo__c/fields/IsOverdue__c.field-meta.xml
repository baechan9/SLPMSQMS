<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsOverdue__c</fullName>
    <formula>AND(ISPICKVAL(Status__c, 'OPEN'), NOT(ISBLANK(DueDate__c)), DueDate__c &lt; TODAY())</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>기한 초과</label>
    <type>Checkbox</type>
</CustomField>
