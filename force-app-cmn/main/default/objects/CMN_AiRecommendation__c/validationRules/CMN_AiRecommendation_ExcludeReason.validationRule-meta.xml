    <active>true</active>
    <description>AI-004 AC-2: 제외는 사유 필수</description>
    <errorConditionFormula>ISPICKVAL(Status__c, 'EXCLUDED') &amp;&amp; ISBLANK(ExcludeReason__c)</errorConditionFormula>
