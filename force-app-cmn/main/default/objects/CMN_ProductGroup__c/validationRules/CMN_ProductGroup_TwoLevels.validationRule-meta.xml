<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_ProductGroup_TwoLevels</fullName>
    <active>true</active>
    <description>제품군은 2단계(상위의 상위 금지, 자기 자신 금지). 하위가 있는 제품군에 상위를 다는 경우는 트리거가 막는다</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Parent__c)), OR(Parent__c = Id, NOT(ISBLANK(Parent__r.Parent__c))))</errorConditionFormula>
    <errorDisplayField>Parent__c</errorDisplayField>
    <errorMessage>제품군은 2단계까지만 둘 수 있습니다.</errorMessage>
</ValidationRule>
