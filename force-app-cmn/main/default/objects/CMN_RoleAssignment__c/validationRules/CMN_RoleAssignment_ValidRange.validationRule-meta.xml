<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_RoleAssignment_ValidRange</fullName>
    <active>true</active>
    <description>종료 ≥ 시작</description>
    <errorConditionFormula>AND(NOT(ISBLANK(ValidTo__c)), ValidTo__c &lt; ValidFrom__c)</errorConditionFormula>
    <errorDisplayField>ValidTo__c</errorDisplayField>
    <errorMessage>유효 종료일은 시작일 이후여야 합니다.</errorMessage>
</ValidationRule>
