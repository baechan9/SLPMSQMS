<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Account_CustomerKeyRequired</fullName>
    <active>true</active>
    <description>고객은 고객 코드·OEM 그룹 필수(CMN-00-MDM-003)</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = 'CMN_Customer', OR(ISBLANK(OemCode__c), ISPICKVAL(CustomerGroup__c, '')))</errorConditionFormula>
    <errorDisplayField>OemCode__c</errorDisplayField>
    <errorMessage>고객은 고객 코드와 OEM 그룹이 필요합니다.</errorMessage>
</ValidationRule>
