<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMN_Account_VendorNoImmutable</fullName>
    <active>true</active>
    <description>SAP 공급업체 번호는 협력사 품번 외부 키의 일부라 바꾸지 않는다(이관 모드 예외)</description>
    <errorConditionFormula>AND(ISCHANGED(SapVendorNo__c), NOT(ISBLANK(PRIORVALUE(SapVendorNo__c))), NOT($Permission.CMN_DataMigration))</errorConditionFormula>
    <errorDisplayField>SapVendorNo__c</errorDisplayField>
    <errorMessage>코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).</errorMessage>
</ValidationRule>
