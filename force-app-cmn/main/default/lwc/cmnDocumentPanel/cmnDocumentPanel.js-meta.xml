<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CMN Document Panel</masterLabel>
    <description
  >문서·리비전 패널(CMN-00-DOC-001). 분류별 현재 리비전·이력, 업로드, 링크 등록, 양식 내려받기, 결재형 상신</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
        name="allowedDocClasses"
        type="String"
        label="Allowed DOC_CLASS codes"
        description="쉼표로 구분한 DOC_CLASS 코드(비우면 전체)"
      />
            <property
        name="requiredDocClasses"
        type="String"
        label="Required DOC_CLASS codes"
        description="쉼표로 구분한 필수 DOC_CLASS 코드"
      />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
