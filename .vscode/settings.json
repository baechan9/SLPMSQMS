{
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sf": true,
    "**/.sfdx": true
  },
  "xml.preferences.showSchemaDocumentationType": "none",
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "markdown.styles": [".vscode/markdown-preview.css"],
  "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', 'Segoe UI', sans-serif",
  "markdown.preview.fontSize": 15,
  "markdown.preview.lineHeight": 1.7,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.lineHeight": 1.6,
    "editor.stickyScroll.enabled": true,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.unicodeHighlight.ambiguousCharacters": false
  }
}
