  "validationRules": [
    {
      "name": "CMN_ProductGroup_TwoLevels",
      "field": "Parent__c",
      "formula": "AND(NOT(ISBLANK(Parent__c)), OR(Parent__c = Id, NOT(ISBLANK(Parent__r.Parent__c))))",
      "description": "제품군은 2단계(상위의 상위 금지, 자기 자신 금지). 하위가 있는 제품군에 상위를 다는 경우는 트리거가 막는다",
      "message": {
        "ko": "제품군은 2단계까지만 둘 수 있습니다.",
        "en_US": "Product groups can have at most two levels.",
        "zh_CN": "产品组最多只能有两级。"
      }
    },
    {
      "name": "CMN_ProductGroup_GroupCodeImmutable",
      "field": "GroupCode__c",
      "formula": "AND(ISCHANGED(GroupCode__c), NOT($Permission.CMN_DataMigration))",
