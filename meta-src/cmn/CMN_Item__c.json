  "validationRules": [
    {
      "name": "CMN_Item_FgRequiresCustomer",
      "field": "Customer__c",
      "formula": "AND(ISPICKVAL(ItemType__c, 'FG'), ISBLANK(Customer__c))",
      "description": "BR-1: 완제품은 고객 필수",
      "message": {
        "ko": "완제품(FG)은 고객이 필요합니다.",
        "en_US": "A finished good (FG) requires a customer.",
        "zh_CN": "成品(FG)需要客户。"
      }
    },
    {
      "name": "CMN_Item_ItemNoImmutable",
      "field": "ItemNo__c",
      "formula": "AND(ISCHANGED(ItemNo__c), NOT($Permission.CMN_DataMigration))",
      "description": "품번은 SAP 키·연결 외부 키라 바꾸지 않는다(이관 모드 예외)",
      "message": {
        "ko": "코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).",
        "en_US": "The code cannot be changed after creation (key for access, numbering and integration).",
        "zh_CN": "代码创建后不可修改(用于权限、编号和外部集成的键)。"
      }
    }
  ],
