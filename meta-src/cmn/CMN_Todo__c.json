      "label": {
        "ko": "공장",
        "en_US": "Plant",
        "zh_CN": "工厂"
      }
    },
    {
      "name": "IsOverdue__c",
      "type": "Formula",
      "returnType": "Checkbox",
      "treatBlanksAs": "BlankAsZero",
      "formula": "AND(ISPICKVAL(Status__c, 'OPEN'), NOT(ISBLANK(DueDate__c)), DueDate__c < TODAY())",
      "label": {
        "ko": "기한 초과",
        "en_US": "Overdue",
        "zh_CN": "已逾期"
      }
