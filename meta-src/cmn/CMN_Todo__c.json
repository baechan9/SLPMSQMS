    {
      "name": "ExternalKey__c",
      "type": "Text",
      "length": 120,
      "externalId": true,
      "unique": true,
      "caseSensitive": true,
      "serviceOnly": true,
      "label": {
        "ko": "외부 키",
        "en_US": "External Key",
        "zh_CN": "外部键"
