  "validationRules": [
    {
      "name": "CMN_Characteristic_SpecOrder",
      "field": "USL__c",
      "formula": "OR(AND(NOT(ISBLANK(LSL__c)), NOT(ISBLANK(USL__c)), LSL__c >= USL__c), AND(NOT(ISBLANK(LSL__c)), NOT(ISBLANK(Nominal__c)), LSL__c >= Nominal__c), AND(NOT(ISBLANK(Nominal__c)), NOT(ISBLANK(USL__c)), Nominal__c >= USL__c))",
      "description": "BR-1: LSL < 기준값 < USL(있는 값끼리)",
      "message": {
        "ko": "규격 순서가 맞지 않습니다(하한 < 기준값 < 상한).",
        "en_US": "Specification limits are out of order (LSL < Nominal < USL).",
        "zh_CN": "规格顺序不正确(下限 < 标称值 < 上限)。"
      }
    },
    {
      "name": "CMN_Characteristic_VariableNeedsLimit",
      "field": "USL__c",
      "formula": "AND(ISPICKVAL(CharType__c, 'VARIABLE'), OR(AND(ISBLANK(USL__c), ISBLANK(LSL__c)), ISBLANK(TEXT(Unit__c))))",
      "description": "계량형은 USL·LSL 중 1개 이상과 단위 필수",
      "message": {
        "ko": "계량형 특성은 상한·하한 규격 중 하나 이상과 단위가 필요합니다.",
        "en_US": "A variable characteristic requires at least one of USL/LSL and a unit.",
        "zh_CN": "计量型特性需要至少一个规格上下限和单位。"
      }
    },
    {
      "name": "CMN_Characteristic_ActiveSpecLocked",
      "field": "USL__c",
      "formula": "AND(ISPICKVAL(PRIORVALUE(Status__c), 'ACTIVE'), OR(ISCHANGED(USL__c), ISCHANGED(LSL__c), ISCHANGED(Nominal__c), ISCHANGED(Unit__c), ISCHANGED(CharType__c), ISCHANGED(SpecialClass__c)), NOT($Permission.CMN_DataMigration))",
      "description": "BR-3·AC-2: ACTIVE 특성 규격 수정 금지(새 버전 안내). 이관 모드 예외",
      "message": {
        "ko": "활성(ACTIVE) 특성의 규격은 바꿀 수 없습니다. 새 버전을 만들어 활성화하세요.",
        "en_US": "Specifications of an ACTIVE characteristic cannot be changed. Create and activate a new version.",
        "zh_CN": "生效(ACTIVE)特性的规格不能修改。请创建新版本并生效。"
      }
    },
    {
      "name": "CMN_Characteristic_ActiveNeedsFrom",
      "field": "EffectiveFrom__c",
      "formula": "AND(ISPICKVAL(Status__c, 'ACTIVE'), ISBLANK(EffectiveFrom__c))",
      "description": "ACTIVE면 적용 시작일 필수",
      "message": {
        "ko": "활성 특성은 적용 시작일이 필요합니다.",
        "en_US": "An active characteristic requires an effective-from date.",
        "zh_CN": "生效特性需要生效日期。"
      }
    },
    {
      "name": "CMN_Characteristic_EffectiveRange",
      "field": "EffectiveTo__c",
      "formula": "AND(NOT(ISBLANK(EffectiveFrom__c)), NOT(ISBLANK(EffectiveTo__c)), EffectiveTo__c < EffectiveFrom__c)",
      "description": "종료일 ≥ 시작일",
      "message": {
        "ko": "적용 종료일은 시작일 이후여야 합니다.",
        "en_US": "Effective-to must be on or after effective-from.",
        "zh_CN": "失效日期必须在生效日期之后。"
      }
    },
    {
      "name": "CMN_Characteristic_StatusRequired",
      "field": "Status__c",
      "formula": "ISBLANK(TEXT(Status__c))",
      "description": "상태 필수(서비스 전용이라 DB 필수 대신)",
      "message": {
        "ko": "상태가 필요합니다.",
        "en_US": "Status is required.",
        "zh_CN": "需要状态。"
      }
    }
  ]
}
