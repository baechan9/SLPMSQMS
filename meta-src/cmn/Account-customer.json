  "validationRules": [
    {
      "name": "CMN_Account_CustomerKeyRequired",
      "field": "OemCode__c",
      "formula": "AND(RecordType.DeveloperName = 'CMN_Customer', OR(ISBLANK(OemCode__c), ISPICKVAL(CustomerGroup__c, '')))",
      "description": "고객은 고객 코드·OEM 그룹 필수(CMN-00-MDM-003)",
      "message": {
        "ko": "고객은 고객 코드와 OEM 그룹이 필요합니다.",
        "en_US": "A customer requires an OEM code and OEM group.",
        "zh_CN": "客户需要客户代码和OEM集团。"
      }
    },
    {
      "name": "CMN_Account_OemCodeImmutable",
      "field": "OemCode__c",
      "formula": "AND(ISCHANGED(OemCode__c), NOT(ISBLANK(PRIORVALUE(OemCode__c))), NOT($Permission.CMN_DataMigration))",
      "description": "고객 코드는 차종 외부 키의 일부라 바꾸지 않는다(CMN-00-MDM-003). 이관 모드만 예외",
      "message": {
        "ko": "코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).",
        "en_US": "The code cannot be changed after creation (key for access, numbering and integration).",
        "zh_CN": "代码创建后不可修改(用于权限、编号和外部集成的键)。"
      }
    }
  ]
