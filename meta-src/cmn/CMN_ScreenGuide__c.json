{
  "wi": "CMN-00-UX-002",
  "object": "CMN_ScreenGuide__c",
  "package": "force-app-cmn",
  "description": "화면별 사용 가이드(UX-002). 1건 = 화면 키 × 언어. 관리자가 개발 없이 내용을 고친다(회사표준 개편 기간 절차 변경 대응). 사용자 언어 → en_US → ko 순으로 대체 표시(BR-2). 공지성 안내는 표준 In-App Guidance로(BR-3). 외부 키는 트리거가 {PageKey}-{Language}로 채운다",
  "label": {
    "ko": "화면 가이드",
    "en_US": "Screen Guide",
    "zh_CN": "画面指南"
  },
  "plural": {
    "ko": "화면 가이드",
    "en_US": "Screen Guides",
    "zh_CN": "画面指南"
  },
  "nameField": {
    "label": {
      "ko": "제목",
      "en_US": "Title",
      "zh_CN": "标题"
    }
  },
  "sharingModel": "Read",
  "externalSharingModel": "Private",
  "tab": {
    "motif": "Custom55: Books"
  },
  "layout": {
    "columns": [
      ["Name", "PageKey__c", "Language__c", "IsPublished__c"],
      ["VideoUrl__c", "StandardDocUrl__c", "ExternalKey__c"]
    ]
  },
