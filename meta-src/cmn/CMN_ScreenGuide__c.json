            "zh_CN": "西班牙语"
          }
        },
        {
          "api": "pt_BR",
          "label": {
            "ko": "포르투갈어(브라질)",
            "en_US": "Portuguese (Brazil)",
            "zh_CN": "葡萄牙语(巴西)"
          }
        }
      ]
    },
    {
      "name": "Content__c",
      "type": "Html",
      "length": 32768,
