      "length": 100,
      "required": true,
      "externalId": true,
      "unique": true,
      "caseSensitive": false,
      "serviceOnly": true,
      "label": {
        "ko": "외부 키",
        "en_US": "External Key",
        "zh_CN": "外部键"
      },
      "description": "{PageKey}-{Language}. 트리거가 채운다(같은 화면·언어 중복 금지)"
    }
