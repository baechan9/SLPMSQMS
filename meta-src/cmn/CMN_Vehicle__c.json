  "validationRules": [
    {
      "name": "CMN_Vehicle_EopAfterSop",
      "field": "EopDate__c",
      "formula": "AND(NOT(ISBLANK(SopDate__c)), NOT(ISBLANK(EopDate__c)), EopDate__c < SopDate__c)",
      "description": "양산 종료는 시작 이후",
      "message": {
        "ko": "양산 종료일은 양산 시작일 이후여야 합니다.",
        "en_US": "EOP must be on or after SOP.",
        "zh_CN": "量产结束日期必须在量产开始日期之后。"
      }
    },
    {
      "name": "CMN_Vehicle_VehicleCodeImmutable",
      "field": "VehicleCode__c",
      "formula": "AND(ISCHANGED(VehicleCode__c), NOT($Permission.CMN_DataMigration))",
      "description": "차종 코드는 외부 키의 일부라 바꾸지 않는다. 이관 모드만 예외",
      "message": {
        "ko": "코드는 만든 뒤 바꿀 수 없습니다(권한·채번·외부 연계의 키).",
        "en_US": "The code cannot be changed after creation (key for access, numbering and integration).",
        "zh_CN": "代码创建后不可修改(用于权限、编号和外部集成的键)。"
      }
    }
  ],
  "i18nName": true,
  "externalSharingModel": "Private"
}
