{
  "wi": "CMN-00-UX-007",
  "object": "CMN_AppMenuItem__mdt",
  "kind": "mdt",
  "package": "force-app-cmn",
  "description": "앱 메뉴 허브의 기능 타일(A0 앱 내비게이션 골격). 화면이 아직 없으면 TargetType NONE + Bundle(1차 화면 묶음)로 '준비 중'을 보이고, 각 묶음이 화면을 만들면 Target을 채운다",
  "label": {
    "ko": "앱 메뉴 항목"
  },
  "plural": {
    "ko": "앱 메뉴 항목"
  },
  "fields": [
    {
      "name": "Menu__c",
      "type": "MetadataRelationship",
      "referenceTo": "CMN_AppMenu__mdt",
      "relationshipName": "Items",
      "relationshipLabel": {
        "ko": "메뉴 항목"
      },
      "label": "Menu"
    },
    {
      "name": "Order__c",
      "type": "Number",
      "precision": 3,
      "scale": 0,
      "label": "Order"
    },
    {
      "name": "FeatureCode__c",
      "type": "Text",
      "length": 20,
      "label": "Feature Code",
      "description": "WI 기능 코드(IQC, NCR 등). 타일에 표시"
    },
    {
      "name": "TitleLabel__c",
      "type": "Text",
      "length": 80,
      "label": "Title Label",
      "description": "제목 Custom Label 이름. 비우면 OBJECT 대상 객체의 복수 라벨"
    },
    {
      "name": "DescLabel__c",
      "type": "Text",
      "length": 80,
      "label": "Description Label",
      "description": "설명 Custom Label 이름(선택)"
    },
    {
      "name": "IconName__c",
      "type": "Text",
      "length": 80,
      "label": "Icon Name"
    },
    {
      "name": "TargetType__c",
      "type": "Picklist",
      "label": "Target Type",
      "default": "NONE",
      "values": [
        {
          "api": "OBJECT",
          "label": "OBJECT"
        },
        {
          "api": "PAGE",
          "label": "PAGE"
        },
        {
          "api": "NONE",
          "label": "NONE"
        }
      ],
      "description": "OBJECT = 객체 목록(Target = 객체 API명, 읽기 권한 없으면 숨김), PAGE = 앱 페이지 탭(Target = 탭 API명), NONE = 준비 중"
    },
    {
      "name": "Target__c",
      "type": "Text",
      "length": 80,
      "label": "Target"
    },
    {
      "name": "Bundle__c",
      "type": "Text",
      "length": 10,
      "label": "Bundle",
      "description": "준비 중 기능의 1차 화면 묶음(A0~A7, screen-first-plan 5절)"
    },
    {
      "name": "IsActive__c",
      "type": "Checkbox",
      "default": true,
      "label": "Active"
    },
    {
      "name": "RequiredPermission__c",
      "type": "Text",
      "length": 80,
      "label": "Required Permission",
      "description": "PAGE·NONE 타일 표시에 필요한 Custom Permission API명(UX-007 BR-4). 비우면 모두에게 보인다"
    },
    {
      "name": "TodoSourceTypes__c",
      "type": "Text",
      "length": 255,
      "label": "To-Do Source Types",
      "description": "미결 배지에 셀 To-Do SourceType(쉼표). * = 내 열린 To-Do 전체(UX-007 BR-5)"
    },
    {
      "name": "KeywordsLabel__c",
      "type": "Text",
      "length": 80,
      "label": "Keywords Label",
      "description": "화면 검색 동의어 Custom Label(쉼표 구분 단어, 3개 언어)"
    },
    {
      "name": "ShowOnPhone__c",
      "type": "Checkbox",
      "default": false,
      "label": "Show On Phone",
      "description": "휴대폰 전체 메뉴 허브에 표시(UX-007 BR-8)"
    }
  ],
